# Server Configuration
PROJECT_NAME="AI-Powered IT Support & Incident Resolution Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
PORT=8000

# Security & API Keys
GEMINI_API_KEY="your_gemini_api_key_here"

# Database Configuration (Neon/Supabase or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/it_support_db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]